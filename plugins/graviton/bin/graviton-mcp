#!/usr/bin/env python3
"""
Executable wrapper for graviton-mcp from within plugin directory.
"""
import os
import sys
from pathlib import Path

REPO_ROOT = None
if "GRAVITON_ROOT" in os.environ and Path(os.environ["GRAVITON_ROOT"]).is_dir():
    REPO_ROOT = Path(os.environ["GRAVITON_ROOT"]).resolve()

if not REPO_ROOT:
    current = Path(__file__).resolve().parent
    for parent in [current.parent, current.parent.parent, current.parent.parent.parent, current.parent.parent.parent.parent]:
        candidate = parent / "bin" / "graviton-mcp"
        if candidate.exists() and candidate.resolve() != Path(__file__).resolve():
            REPO_ROOT = parent
            break

if REPO_ROOT:
    target_bin = REPO_ROOT / "bin" / "graviton-mcp"
    if target_bin.exists():
        os.execv(sys.executable, [sys.executable, str(target_bin)] + sys.argv[1:])

sys.stderr.write("Error: Could not locate Graviton repository root or bin/graviton-mcp\n")
sys.exit(1)
